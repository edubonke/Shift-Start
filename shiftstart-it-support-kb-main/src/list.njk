---
layout: layouts/base.njk
pagination:
  data: types
  size: 1
  alias: type
permalink: "{{ type.slug }}/index.html"
eleventyComputed:
  title: "{{ type.title }}"
---
<section class="shell py-10"><h1>{{ type.title }}</h1><p class="mt-3 text-slate-600">{{ type.description }}</p><div class="mt-8 grid gap-4 md:grid-cols-2">{% for item in collections.kb %}{% if item.data.content_type == type.content_type %}<a class="card" href="{{ item.url | url }}"><div class="flex justify-between gap-4"><strong>{{ item.data.title }}</strong>{% if item.data.severity %}<span class="badge">{{ item.data.severity }}</span>{% endif %}</div><p class="mt-2 text-sm text-slate-600">{{ item.data.description }}</p></a>{% endif %}{% endfor %}</div></section>
